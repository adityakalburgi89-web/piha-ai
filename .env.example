# ==========================================
# Piha AI — Environment Configuration
# ==========================================

# 1. Next.js & Server
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. LiveKit SFU (WebRTC Audio Core)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretkey
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# 3. Multilingual Speech & Indic Models (Sarvam AI)
SARVAM_API_KEY=your_sarvam_api_key_here
CARTESIA_API_KEY=your_cartesia_api_key_here

# 4. Cognitive Reasoning LLMs
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# 5. LavinMQ / AMQP Message Broker (Decoupled Side-Effects)
AMQP_URL=amqp://guest:guest@localhost:5672/

# 6. Outbound Telephony Fallback (OmniDimension / SIP)
OMNIDIMENSION_API_KEY=your_omnidimension_api_key_here
OMNIDIMENSION_AGENT_ID=your_omnidimension_agent_id_here

# 7. WhatsApp Integration (Brochures & Catalogs)
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# UltraMsg (Alternative WhatsApp)
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# 8. Google Calendar Integration
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# 9. Persistence & Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/piha_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
REDIS_URL=redis://localhost:6379